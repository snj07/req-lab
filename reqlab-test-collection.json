        {
            "name": "Scripts & Tests",
            "folders": [],
            "requests": [
                {
                    "name": "Timestamp \u2013 pre-request captures server time",
                    "method": "GET",
                    "url": "{{baseUrl}}/api/timestamp",
                    "preRequestScript": "console.log(\"Fetching server timestamp\u2026\")",
                    "testScript": "pm.test(\"Status is 200\", function() {\n    pm.expect(pm.response.code).to.equal(200)\n})\npm.test(\"Response has unix timestamp\", function() {\n    pm.expect(pm.response.json().unix).to.be.above(0)\n})\npm.test(\"Response has iso field\", function() {\n    pm.expect(pm.response.text()).to.include(\"iso\")\n})\npm.environment.set(\"serverTimestamp\", pm.response.json().unix)"
                },
                {
                    "name": "Token \u2013 pre-request fetches auth token",
                    "method": "POST",
                    "url": "{{baseUrl}}/api/token",
                    "body": {
                        "type": "JSON",
                        "content": "{\n  \"user\": \"alice\",\n  \"role\": \"admin\"\n}"
                    },
                    "preRequestScript": "pm.environment.set(\"requestUser\", \"alice\")\npm.environment.set(\"requestRole\", \"admin\")\nconsole.log(\"Requesting token for\", pm.environment.get(\"requestUser\"))",
                    "testScript": "pm.test(\"Status is 200\", function() {\n    pm.expect(pm.response.code).to.equal(200)\n})\npm.test(\"Token is present in response\", function() {\n    pm.expect(pm.response.json().token).to.include(\"rl.\")\n})\npm.test(\"User matches request\", function() {\n    pm.expect(pm.response.json().user).to.equal(\"alice\")\n})\npm.environment.set(\"scriptToken\", pm.response.json().token)\nconsole.log(\"Stored token:\", pm.environment.get(\"scriptToken\"))"
                },
                {
                    "name": "Protected \u2013 validate access with stored token",
                    "method": "GET",
                    "url": "{{baseUrl}}/api/protected",
                    "headers": [
                        {"key": "X-Token", "value": "{{scriptToken}}"}
                    ],
                    "preRequestScript": "pm.environment.set(\"X-Token\", pm.environment.get(\"scriptToken\"))\nconsole.log(\"X-Token set from scriptToken:\", pm.environment.get(\"scriptToken\"))",
                    "testScript": "pm.test(\"Status is 200 or 401\", function() {\n    pm.expect(pm.response.code).to.be.oneOf([200, 401])\n})\npm.test(\"Response body is valid JSON\", function() {\n    pm.expect(pm.response.text()).to.include(\"{\")\n})"
                },
                {
                    "name": "Validate JSON Body \u2013 assert schema",
                    "method": "POST",
                    "url": "{{baseUrl}}/api/validate",
                    "body": {
                        "type": "JSON",
                        "content": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"age\": 30,\n  \"city\": \"Springfield\"\n}"
                    },
                    "preRequestScript": "console.log(\"Sending JSON body for schema validation\")",
                    "testScript": "pm.test(\"Status is 200\", function() {\n    pm.expect(pm.response.code).to.equal(200)\n})\npm.test(\"Body is valid JSON\", function() {\n    pm.expect(pm.response.json().valid).to.equal(true)\n})\npm.test(\"Field count is above 0\", function() {\n    pm.expect(pm.response.json().fieldCount).to.be.above(0)\n})\nconsole.log(\"Validated\", pm.response.json().fieldCount, \"fields\")"
                },
                {
                    "name": "Echo Full \u2013 verify pre-request header injection",
                    "method": "GET",
                    "url": "{{baseUrl}}/api/echo-full",
                    "headers": [
                        {"key": "X-Request-Id", "value": "{{X-Request-Id}}"},
                        {"key": "X-Client", "value": "{{X-Client}}"}
                    ],
                    "preRequestScript": "pm.environment.set(\"X-Request-Id\", \"req-scripted\")\npm.environment.set(\"X-Client\", \"ReqLab-ScriptEngine\")\nconsole.log(\"Injecting X-Request-Id and X-Client via pre-request script\")",
                    "testScript": "pm.test(\"Status is 200\", function() {\n    pm.expect(pm.response.code).to.equal(200)\n})\npm.test(\"Method is GET\", function() {\n    pm.expect(pm.response.json().method).to.equal(\"GET\")\n})\npm.test(\"Response has headers object\", function() {\n    pm.expect(pm.response.text()).to.include(\"headers\")\n})\nconsole.log(\"Echo path:\", pm.response.json().path)"
                },
                {
                    "name": "User List \u2013 validate response structure",
                    "method": "GET",
                    "url": "{{baseUrl}}/api/users",
                    "preRequestScript": "console.log(\"Fetching user list from\", pm.environment.get(\"baseUrl\"))",
                    "testScript": "pm.test(\"Status is 200\", function() {\n    pm.expect(pm.response.code).to.equal(200)\n})\npm.test(\"Response has users array\", function() {\n    pm.expect(pm.response.text()).to.include(\"users\")\n})\npm.test(\"Method field is GET\", function() {\n    pm.expect(pm.response.json().method).to.equal(\"GET\")\n})\nconsole.log(\"User list loaded successfully\")"
                }
            ]
        }
